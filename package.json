{
  "name": "c-shepherd-speller",
  "version": "0.1.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --import-plugin",
    "lint:fix": "oxlint --fix --import-plugin",
    "lint:all": "npm run lint:ox",
    "test-db": "node scripts/test-db.mjs",
    "create-tables": "node scripts/create-tables.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pre-commit": "lint-staged",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1145.0",
    "@aws-sdk/lib-dynamodb": "^3.1145.0",
    "@aws-sdk/util-dynamodb": "^3.864.0",
    "@next-auth/dynamodb-adapter": "^3.0.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10",
    "eslint-config-next": "16.3.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix --import-plugin",
      "prettier --write"
    ],
    "*.{json,css,md,html}": "prettier --write"
  }
}
