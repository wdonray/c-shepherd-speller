{
  "name": "c-shepherd-speller",
  "version": "0.22.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --import-plugin",
    "lint:fix": "oxlint --fix --import-plugin",
    "lint:all": "npm run lint:ox",
    "test-db": "node scripts/test-db.mjs",
    "create-tables": "node scripts/create-tables.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pre-commit": "lint-staged",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.864.0",
    "@aws-sdk/lib-dynamodb": "^3.864.0",
    "@aws-sdk/util-dynamodb": "^3.864.0",
    "@dnd-kit/core": "^6.3.1",
    "@next-auth/dynamodb-adapter": "^3.0.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@sentry/nextjs": "^10.76.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "lucide-react": "^0.539.0",
    "next": "16.3.8",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "oxlint": "^1.11.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix --import-plugin",
      "prettier --write"
    ],
    "*.{json,css,md,html}": "prettier --write"
  },
  "overrides": {
    "@auth/core": {
      "cookie": "0.7.2"
    },
    "@humanfs/node": "0.16.8",
    "@smithy/config-resolver": "4.4.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.9"
    },
    "ajv": "6.14.0",
    "brace-expansion": "1.1.21",
    "fast-xml-parser": "5.7.0",
    "flatted": "3.4.2",
    "js-yaml": "4.3.2",
    "minimatch": "3.1.4",
    "picomatch": "2.3.2",
    "postcss": "8.5.29",
    "sharp": "0.35.5",
    "tar": "7.5.22",
    "uuid": "11.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
