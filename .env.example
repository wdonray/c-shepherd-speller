# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-one-with-openssl-rand-base64-32

# DynamoDB access (used by the app and by scripts/create-tables.mjs)
AUTH_DYNAMODB_REGION=us-east-1
AUTH_DYNAMODB_ID=
AUTH_DYNAMODB_SECRET=

# Table names (defaults shown; leave unset to use them)
USER_TABLE_NAME=c-shepherd-users
AUTH_TABLE_NAME=next-auth

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cognito email/password sign-in (optional). The "Continue with email" button
# only appears on the sign-in page when all three are set. Create a User Pool
# with email as the username, add an app client that generates a client
# secret, and configure the Hosted UI with these callback/sign-out URLs:
#   https://patternspell.org/api/auth/callback/cognito
#   https://patternspell.org/auth/signin
# plus the localhost equivalents for local dev. See README for the full setup.
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/<user-pool-id>
# Optional: a custom domain for the Cognito Hosted UI (e.g.
# https://auth.patternspell.org) so teachers never see the default
# amazoncognito.com URL. Leave empty to use the pool's default domain.
COGNITO_HOSTED_UI_DOMAIN=

# DynamoDB Local (local development, no AWS account needed)
# Start: docker run -p 8000:8000 amazon/dynamodb-local
# Then run: npm run create-tables
# DynamoDB Local accepts any credentials; DYNAMODB_ENDPOINT is what routes there.
DYNAMODB_ENDPOINT=http://localhost:8000

# Sentry error tracking (optional in local dev; set in production via Amplify env vars)
NEXT_PUBLIC_SENTRY_DSN=

# Feedback form ("Report an issue" page). Submissions are emailed through SES
# in us-east-1. While the AWS account is in the SES sandbox, the recipient
# must be a verified SES identity; after production access is granted, any
# address works with no code change.
FEEDBACK_TO_EMAIL=donrayxwilliams@gmail.com
FEEDBACK_FROM_EMAIL=PatternSpell <no-reply@patternspell.org>
# Optional: override the region and credentials used for SES. When the
# credentials are unset, the default AWS credential chain is used (the Amplify
# service role in production, which needs ses:SendEmail on the identity).
FEEDBACK_SES_REGION=us-east-1
FEEDBACK_SES_ACCESS_KEY_ID=
FEEDBACK_SES_SECRET_ACCESS_KEY=

# Bot/spam protection for email sign-up (Cloudflare Turnstile, free).
# Create a widget at https://dash.cloudflare.com/turnstile for patternspell.org
# (managed or invisible mode), then add both keys as Amplify environment
# variables on all branches. Local dev can use Cloudflare's public test keys
# (they always pass verification):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=<redacted>
# When the keys are unset locally, Turnstile verification is skipped (dev and
# test only). In production the signup API fails closed with a 503 if the
# secret key is missing, so a misconfigured deploy can never silently drop
# the protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
