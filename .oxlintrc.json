{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "dist/",
    "build/",
    "*.config.js",
    "*.config.ts"
  ],
  "overrides": [
    {
      "files": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx"
      ],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ],
  "plugins": [
    "typescript",
    "react",
    "jsx-a11y",
    "nextjs"
  ],
  "rules": {},
  "settings": {
    "next": {
      "rootDir": "./"
    },
    "react": {
      "version": "19.3.0"
    }
  },
  "categories": {
    "correctness": "warn",
    "nursery": "off",
    "pedantic": "off",
    "perf": "warn",
    "restriction": "off",
    "style": "warn",
    "suspicious": "warn"
  }
}
